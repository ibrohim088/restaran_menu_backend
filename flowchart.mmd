    AuthCtrl --> User
    AdminCtrl --> User
    RestaranCtrl --> Restaran
    CategoryCtrl --> Category
    MenuCtrl --> MenuItem
    PublicCtrl --> Restaran & Category & MenuItem

    AuthCtrl & AdminCtrl & RestaranCtrl & CategoryCtrl & MenuCtrl --> Auth
