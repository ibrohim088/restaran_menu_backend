{
  "info": {
    "name": "QR Restoran Menyu API - To'liq v2.0",
    "description": "QR Restoran Menyu Tizimi - SuperAdmin va Admin uchun to'liq Postman Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "🔑 Super Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superadmin@qrmenu.uz\",\n  \"password\": \"123456\"\n}"
            },
            "url": "{{BASE_URL}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const res = pm.response.json();",
                  "    pm.environment.set('TOKEN', res.accessToken);",
                  "    pm.environment.set('REFRESH_TOKEN', res.refreshToken);",
                  "    console.log('✅ Super Admin Token va Refresh Token saqlandi');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "🔑 Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testadmin@qrmenu.uz\",\n  \"password\": \"123456\"\n}"
            },
            "url": "{{BASE_URL}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const res = pm.response.json();",
                  "    pm.environment.set('ADMIN_TOKEN', res.accessToken);",
                  "    pm.environment.set('ADMIN_REFRESH_TOKEN', res.refreshToken);",
                  "    console.log('✅ Admin Token va Refresh Token saqlandi');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "🔄 Refresh Token (Super Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{REFRESH_TOKEN}}\"\n}"
            },
            "url": "{{BASE_URL}}/auth/refresh"
          }
        },
        {
          "name": "🔄 Refresh Token (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{ADMIN_REFRESH_TOKEN}}\"\n}"
            },
            "url": "{{BASE_URL}}/auth/refresh"
          }
        },
        {
          "name": "👤 Get Me (Super Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}"
              }
            ],
            "url": "{{BASE_URL}}/auth/me"
          }
        },
        {
          "name": "👤 Get Me (Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ADMIN_TOKEN}}"
              }
            ],
            "url": "{{BASE_URL}}/auth/me"
          }
        },
        {
          "name": "🚪 Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}"
              }
            ],
            "url": "{{BASE_URL}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "👤 Admins (Super Admin)",
      "item": [
        {
          "name": "Get All Admins",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}"
              }
            ],
            "url": "{{BASE_URL}}/admins"
          }
        },
        {
          "name": "Create Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Test Admin\",\n  \"email\": \"testadmin@qrmenu.uz\",\n  \"password\": \"123456\"\n}"
            },
            "url": "{{BASE_URL}}/admins"
          }
        },
        {
          "name": "Get Admin by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}"
              }
            ],
            "url": "{{BASE_URL}}/admins/{{adminId}}"
          }
        },
        {
          "name": "Update Admin",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Updated Admin\"\n}"
            },
            "url": "{{BASE_URL}}/admins/{{adminId}}"
          }
        },
        {
          "name": "Delete Admin",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}"
              }
            ],
            "url": "{{BASE_URL}}/admins/{{adminId}}"
          }
        },
        {
          "name": "Toggle Admin",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}"
              }
            ],
            "url": "{{BASE_URL}}/admins/{{adminId}}/toggle"
          }
        }
      ]
    },
    {
